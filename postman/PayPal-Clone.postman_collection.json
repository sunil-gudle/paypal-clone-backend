    {
      "name": "Transactions",
      "description": "Money transfers, refunds and history",
      "item": [
        {
          "name": "Transfer Money",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Transfer completed', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('COMPLETED');",
                  "    pm.expect(json.data.referenceId).to.be.a('string');",
                  "",
                  "    // Save transaction ID for refund test",
                  "    pm.environment.set('transactionId', json.data.id);",
                  "    pm.environment.set('referenceId', json.data.referenceId);",
                  "    console.log('Transaction ID saved: ' + json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"jane@example.com\",\n  \"amount\": 100.00,\n  \"note\": \"Dinner split\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "transfer"]
            }
          }
        },
        {
          "name": "Transfer Money (with Idempotency Key)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique idempotency key if not already set",
                  "if (!pm.environment.get('idempotencyKey')) {",
                  "    pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"jane@example.com\",\n  \"amount\": 50.00,\n  \"note\": \"Idempotent transfer\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "transfer"]
            }
          }
        },
        {
          "name": "Get Transaction History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Paginated response', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.content).to.be.an('array');",
                  "    pm.expect(json.data.totalElements).to.be.a('number');",
                  "    console.log('Total transactions: ' + json.data.totalElements);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "type", "value": "TRANSFER", "disabled": true },
                { "key": "status", "value": "COMPLETED", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Transaction by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Transaction data returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{transactionId}}"]
            }
          }
        },
        {
          "name": "Get Transaction by Reference ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/reference/{{referenceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "reference", "{{referenceId}}"]
            }
          }
        },
        {
          "name": "Refund Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Refund processed', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.type).to.eql('REFUND');",
                  "    pm.expect(json.data.status).to.eql('COMPLETED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/refund",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{transactionId}}", "refund"]
            }
          }
        }
      ]
    },
